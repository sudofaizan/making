# BTCUSD handler — ./init.sh -e env/ETH.env start  (runs beside GOLD if magics/logs differ)

# --- run identity (isolates logs/PIDs when multiple assets run) ---
RUN_TAG=BTCUSD

# --- MT5 VPS API (mt5_api.sh) ---
MT5_HOST=172.31.14.247
MT5_PORT=8081
API_KEY=alphafx
MT5_CURL_MAX=30
MT5_CMD=./mt5

# Optional overrides (default: <repo>/logs/<RUN_TAG>, <repo>/pids/<RUN_TAG>)
# LOG_DIR=
# PID_DIR=
LOG_CLEAN_EVERY_HOURS=12

# --- symbol & PRIMARY regime ---
SYMBOL=BTCUSD
PERIOD=200
METHOD=EMA
EMA_TIMEFRAME=M5
# M5 bars for EMA calc — need enough history (250 vs 600 changes GOLD ~5 pts vs chart)
EMA_CANDLE_COUNT=2000
EMA_BARS_MULT=
MT5_CONNECT_TIMEOUT=10
BUY_MAGIC=777
SELL_MAGIC=888
# Broker min/step for BTCUSD# is 0.02 — 0.01 requests are filled as 0.02; vmin/vmax must match or sync re-places every tick
PRIMARY_VOLUME=0.02
PRIMARY_VOLUME_MIN=0.019
PRIMARY_VOLUME_MAX=0.021
COMMENT=PRIMARY

# --- PSW (swing OB limits via SWINGKING/deploy) ---
PSW_COMMENT=PSW
PSW_TP_POINTS=20000
PSW_ACK_ORDER_TYPE=buy_stop
PSW_ACK_VOLUME=0.14
PSW_ACK_VOL_EPS=0.001
# PSW_VOLUME=  # defaults to PRIMARY_VOLUME
TC_ANCHOR_COMMENTS="PSW PRIMARY"
PSW_ACK_POLL_SLEEP=5
PSW_STATE_FILE=./SWINGKING/zones/.psw_deployed_BTCUSD

# --- maintain_order.sh ---
LOOP_SLEEP=5
PRICE_EPS=0.02
POINTS_PROFIT_MIN=1000
RETRY_DELAY=5

# --- TC grid (tc_grid_lib) ---
# Place L1 only when PRIMARY is this many points against you (not merely open/losing).
TC_GRID_ARM_LOSS_PTS=600
GAP=20000
BASKET_PCT=0.10
MAX_LEVEL=10
PLACE_COOLDOWN=30
GRID_PRICE_EPS=0.02
TC_LOOP_SLEEP=1
TC_BUY_TARGETBASKET=1
TC_SELL_TARGETBASKET=0.1