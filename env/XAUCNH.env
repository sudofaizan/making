# XAUCNH stack — ./init.sh -e env/XAUCNH.env start

# --- run identity (isolates logs/PIDs when multiple assets run) ---
RUN_TAG=XAUCNH

# --- MT5 VPS API (mt5_api.sh) ---
MT5_HOST=172.31.14.247
MT5_PORT=8081
API_KEY=alphafx
MT5_CURL_MAX=30
MT5_CMD=./mt5

LOG_CLEAN_EVERY_HOURS=12

# --- symbol & PRIMARY regime ---
SYMBOL=XAUCNH
PERIOD=200
METHOD=EMA
EMA_TIMEFRAME=M5
EMA_CANDLE_COUNT=2000
EMA_BARS_MULT=
MT5_CONNECT_TIMEOUT=10
BUY_MAGIC=779
SELL_MAGIC=889
PRIMARY_VOLUME=0.01
PRIMARY_VOLUME_MIN=0.0095
PRIMARY_VOLUME_MAX=0.0105
COMMENT=PRIMARY

# --- PSW (swing OB limits via SWINGKING/deploy) ---
PSW_COMMENT=PSW
PSW_TP_POINTS=2000
PSW_ACK_ORDER_TYPE=buy_stop
PSW_ACK_VOLUME=0.14
PSW_ACK_VOL_EPS=0.001
TC_ANCHOR_COMMENTS="PSW PRIMARY"
PSW_ACK_POLL_SLEEP=5
PSW_STATE_FILE=./SWINGKING/zones/.psw_deployed_XAUCNH

# --- maintain_order.sh ---
LOOP_SLEEP=5
PRICE_EPS=0.02
POINTS_PROFIT_MIN=1000
RETRY_DELAY=5

# --- TC grid (tc_grid_lib) ---
TC_GRID_ARM_LOSS_PTS=2701
GAP=3376
BASKET_PCT=0.10
MAX_LEVEL=10
PLACE_COOLDOWN=30
GRID_PRICE_EPS=0.02
TC_LOOP_SLEEP=1
TC_BUY_TARGETBASKET=1
TC_SELL_TARGETBASKET=0.1