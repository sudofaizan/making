# GOLD handler — source via: ENV_FILE=./var.env ./init.sh start
# Or: ./init.sh -e var.env start

# --- run identity (isolates logs/PIDs when multiple assets run) ---
RUN_TAG=GOLD

# --- MT5 VPS API (mt5_api.sh) ---
MT5_HOST=35.179.17.137
MT5_PORT=8081
API_KEY=alphafx
MT5_CURL_MAX=30
MT5_CMD=./mt5

# Optional overrides (default: <repo>/logs/<RUN_TAG>, <repo>/pids/<RUN_TAG>)
# LOG_DIR=
# PID_DIR=

# --- symbol & PRIMARY regime ---
SYMBOL=GOLD
PERIOD=200
METHOD=EMA
EMA_TIMEFRAME=M5
# M5 bars for EMA calc — need enough history (250 vs 600 changes GOLD ~5 pts vs chart)
EMA_CANDLE_COUNT=2000
EMA_BARS_MULT=
MT5_CONNECT_TIMEOUT=10
BUY_MAGIC=786
SELL_MAGIC=788
PRIMARY_VOLUME=0.01
PRIMARY_VOLUME_MIN=0.0095
PRIMARY_VOLUME_MAX=0.0105
COMMENT=PRIMARY

# --- maintain_order.sh ---
LOOP_SLEEP=5
PRICE_EPS=0.02
POINTS_PROFIT_MIN=500
RETRY_DELAY=5

# --- TC grid (tc_grid_lib) ---
# Place L1 only when PRIMARY is this many points against you (not merely open/losing).
TC_GRID_ARM_LOSS_PTS=600
GAP=750
BASKET_PCT=0.10
MAX_LEVEL=10
PLACE_COOLDOWN=30
GRID_PRICE_EPS=0.02
TC_LOOP_SLEEP=1
TC_BUY_TARGETBASKET=1
TC_SELL_TARGETBASKET=0.1