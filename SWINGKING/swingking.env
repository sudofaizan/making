# Match TradingView: BigBeluga SMC [1.0.0] inputs (screenshots)
SYMBOL=GOLD
TIMEFRAME=M5

# MARKET STRUCTURE — Window ✓ 5000, Swing ✓ 100, Algo length 5
CANDLE_COUNT=5000
MS_WINDOW_ENABLED=1
MS_WINDOW=5000
MS_LEN=5
SWING_LIMIT=100

# VOLUMETRIC ORDER BLOCKS — Show last 5, Construction Length 5, Mitigation Close
OB_LAST=5
OB_LEN=5
OB_MODE=Length
OB_MITI=Close
HIDE_OVERLAP=1
OVERLAP_KEEP=Recent

# FVG section off on chart (not computed here)

ENV_FILE=../var.env
MT5_CMD=../mt5
LOOP_SLEEP=60
OUT_DIR=./zones
RUN_TAG=GOLD