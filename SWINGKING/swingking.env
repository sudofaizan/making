# BigBeluga SMC-style zone detection (see swingking.sh)
SYMBOL=GOLD
TIMEFRAME=M5
CANDLE_COUNT=5000
MS_WINDOW=5000
MS_LEN=5
OB_LAST=5
OB_LEN=5
OB_MODE=Length
OB_MITI=Close
SWING_LIMIT=100
HIDE_OVERLAP=1
OVERLAP_KEEP=Recent
# Path to MAKING mt5 + shared VPS credentials
ENV_FILE=../var.env
MT5_CMD=../mt5
LOOP_SLEEP=60
OUT_DIR=./zones